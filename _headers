/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://static.cloudflareinsights.com; worker-src 'self' blob:; child-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://cdnjs.cloudflare.com; connect-src 'self' https://lhdgoofzgkrqetjbnowg.supabase.co https://cloudflareinsights.com https://tiles.openfreemap.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

# 数据文件：固定信息可以缓存久一点，实时价格文件让浏览器和 CDN 最多缓存 5 分钟
/data/condos.json
  Cache-Control: public, max-age=3600, must-revalidate
/data/prices.json
  Cache-Control: public, max-age=300, must-revalidate
/data/price-history.json
  Cache-Control: public, max-age=300, must-revalidate
/data/refresh-log.json
  Cache-Control: public, max-age=300, must-revalidate

# 后台和接口：不缓存、不索引（登录由 Cloudflare Access 负责，Functions 再校验）
/console/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/login/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/api/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
